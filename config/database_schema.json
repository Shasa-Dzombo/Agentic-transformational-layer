{
  "database": {
    "name": "data_analyst_db",
    "version": "1.0.0",
    "last_updated": "2025-01-22",
    "description": "Sample database schema for data analyst agent",
    "tables": {
      "demographics": {
        "description": "Demographic information for individuals",
        "columns": {
          "individual_id": {
            "type": "integer",
            "nullable": false,
            "primary_key": true,
            "description": "Unique identifier for individual"
          },
          "age": {
            "type": "integer",
            "nullable": false,
            "description": "Age in years",
            "constraints": {
              "min": 0,
              "max": 150
            }
          },
          "gender": {
            "type": "character varying",
            "nullable": true,
            "description": "Gender identity",
            "allowed_values": ["Male", "Female", "Non-binary", "Other", "Prefer not to say"]
          },
          "race": {
            "type": "character varying",
            "nullable": true,
            "description": "Racial identity",
            "allowed_values": ["White", "Black or African American", "Asian", "Hispanic or Latino", "Native American", "Pacific Islander", "Mixed", "Other"]
          },
          "ethnicity": {
            "type": "character varying",
            "nullable": true,
            "description": "Ethnic background"
          },
          "birth_date": {
            "type": "date",
            "nullable": false,
            "description": "Date of birth"
          },
          "location": {
            "type": "character varying",
            "nullable": true,
            "description": "Geographic location/residence"
          },
          "postal_code": {
            "type": "character varying",
            "nullable": true,
            "description": "Postal/ZIP code"
          },
          "country": {
            "type": "character varying",
            "nullable": true,
            "description": "Country of residence"
          },
          "created_at": {
            "type": "timestamp with time zone",
            "nullable": false,
            "default": "now()",
            "description": "Record creation timestamp"
          },
          "updated_at": {
            "type": "timestamp with time zone",
            "nullable": false,
            "default": "now()",
            "description": "Record last update timestamp"
          }
        }
      },
      "employment": {
        "description": "Employment and income information",
        "columns": {
          "employment_id": {
            "type": "integer",
            "nullable": false,
            "primary_key": true,
            "description": "Unique employment record identifier"
          },
          "individual_id": {
            "type": "integer",
            "nullable": false,
            "foreign_key": {
              "references": "demographics.individual_id"
            },
            "description": "Reference to individual"
          },
          "employment_status": {
            "type": "character varying",
            "nullable": false,
            "description": "Current employment status",
            "allowed_values": ["Employed full-time", "Employed part-time", "Self-employed", "Unemployed", "Student", "Retired", "Other"]
          },
          "occupation": {
            "type": "character varying",
            "nullable": true,
            "description": "Job title or occupation"
          },
          "industry": {
            "type": "character varying",
            "nullable": true,
            "description": "Industry sector"
          },
          "income": {
            "type": "numeric",
            "nullable": true,
            "description": "Annual gross income in USD",
            "constraints": {
              "min": 0
            }
          },
          "salary": {
            "type": "numeric",
            "nullable": true,
            "description": "Monthly salary in USD",
            "constraints": {
              "min": 0
            }
          },
          "income_bracket": {
            "type": "character varying",
            "nullable": true,
            "description": "Income range category",
            "allowed_values": ["Under $25k", "$25k-$50k", "$50k-$75k", "$75k-$100k", "$100k-$150k", "Over $150k"]
          },
          "years_experience": {
            "type": "integer",
            "nullable": true,
            "description": "Years of work experience",
            "constraints": {
              "min": 0,
              "max": 60
            }
          },
          "education_level": {
            "type": "character varying",
            "nullable": true,
            "description": "Highest education level completed",
            "allowed_values": ["Less than High School", "High School", "Some College", "Associate Degree", "Bachelor's Degree", "Master's Degree", "Doctoral Degree"]
          },
          "employment_start_date": {
            "type": "date",
            "nullable": true,
            "description": "Start date of current employment"
          },
          "created_at": {
            "type": "timestamp with time zone",
            "nullable": false,
            "default": "now()",
            "description": "Record creation timestamp"
          },
          "updated_at": {
            "type": "timestamp with time zone",
            "nullable": false,
            "default": "now()",
            "description": "Record last update timestamp"
          }
        }
      },
      "health_metrics": {
        "description": "Health and physical measurement data",
        "columns": {
          "health_id": {
            "type": "integer",
            "nullable": false,
            "primary_key": true,
            "description": "Unique health record identifier"
          },
          "individual_id": {
            "type": "integer",
            "nullable": false,
            "foreign_key": {
              "references": "demographics.individual_id"
            },
            "description": "Reference to individual"
          },
          "height": {
            "type": "numeric",
            "nullable": true,
            "description": "Height in centimeters",
            "constraints": {
              "min": 50,
              "max": 250
            }
          },
          "weight": {
            "type": "numeric",
            "nullable": true,
            "description": "Weight in kilograms",
            "constraints": {
              "min": 20,
              "max": 300
            }
          },
          "bmi": {
            "type": "numeric",
            "nullable": true,
            "description": "Body Mass Index",
            "constraints": {
              "min": 10,
              "max": 60
            }
          },
          "blood_pressure_systolic": {
            "type": "integer",
            "nullable": true,
            "description": "Systolic blood pressure (mmHg)",
            "constraints": {
              "min": 70,
              "max": 200
            }
          },
          "blood_pressure_diastolic": {
            "type": "integer",
            "nullable": true,
            "description": "Diastolic blood pressure (mmHg)",
            "constraints": {
              "min": 40,
              "max": 120
            }
          },
          "cholesterol": {
            "type": "numeric",
            "nullable": true,
            "description": "Total cholesterol level (mg/dL)",
            "constraints": {
              "min": 100,
              "max": 400
            }
          },
          "glucose": {
            "type": "numeric",
            "nullable": true,
            "description": "Fasting glucose level (mg/dL)",
            "constraints": {
              "min": 50,
              "max": 300
            }
          },
          "measurement_date": {
            "type": "date",
            "nullable": false,
            "description": "Date of health measurements"
          },
          "created_at": {
            "type": "timestamp with time zone",
            "nullable": false,
            "default": "now()",
            "description": "Record creation timestamp"
          },
          "updated_at": {
            "type": "timestamp with time zone",
            "nullable": false,
            "default": "now()",
            "description": "Record last update timestamp"
          }
        }
      },
      "education": {
        "description": "Educational background and achievements",
        "columns": {
          "education_id": {
            "type": "integer",
            "nullable": false,
            "primary_key": true,
            "description": "Unique education record identifier"
          },
          "individual_id": {
            "type": "integer",
            "nullable": false,
            "foreign_key": {
              "references": "demographics.individual_id"
            },
            "description": "Reference to individual"
          },
          "degree_type": {
            "type": "character varying",
            "nullable": false,
            "description": "Type of degree or certification",
            "allowed_values": ["High School Diploma", "GED", "Certificate", "Associate Degree", "Bachelor's Degree", "Master's Degree", "Doctoral Degree", "Professional Degree"]
          },
          "field_of_study": {
            "type": "character varying",
            "nullable": true,
            "description": "Major or field of study"
          },
          "institution": {
            "type": "character varying",
            "nullable": true,
            "description": "Educational institution name"
          },
          "graduation_year": {
            "type": "integer",
            "nullable": true,
            "description": "Year of graduation",
            "constraints": {
              "min": 1950,
              "max": 2030
            }
          },
          "gpa": {
            "type": "numeric",
            "nullable": true,
            "description": "Grade Point Average",
            "constraints": {
              "min": 0.0,
              "max": 4.0
            }
          },
          "honors": {
            "type": "character varying",
            "nullable": true,
            "description": "Academic honors received"
          },
          "created_at": {
            "type": "timestamp with time zone",
            "nullable": false,
            "default": "now()",
            "description": "Record creation timestamp"
          },
          "updated_at": {
            "type": "timestamp with time zone",
            "nullable": false,
            "default": "now()",
            "description": "Record last update timestamp"
          }
        }
      },
      "survey_responses": {
        "description": "Survey and questionnaire responses",
        "columns": {
          "response_id": {
            "type": "integer",
            "nullable": false,
            "primary_key": true,
            "description": "Unique response identifier"
          },
          "individual_id": {
            "type": "integer",
            "nullable": false,
            "foreign_key": {
              "references": "demographics.individual_id"
            },
            "description": "Reference to individual"
          },
          "survey_name": {
            "type": "character varying",
            "nullable": false,
            "description": "Name or identifier of survey"
          },
          "question_id": {
            "type": "character varying",
            "nullable": false,
            "description": "Question identifier"
          },
          "question_text": {
            "type": "text",
            "nullable": false,
            "description": "Full text of the question"
          },
          "response_text": {
            "type": "text",
            "nullable": true,
            "description": "Text response to question"
          },
          "response_numeric": {
            "type": "numeric",
            "nullable": true,
            "description": "Numeric response (ratings, scales, etc.)"
          },
          "response_category": {
            "type": "character varying",
            "nullable": true,
            "description": "Categorical response"
          },
          "response_date": {
            "type": "timestamp with time zone",
            "nullable": false,
            "description": "Date and time of response"
          },
          "created_at": {
            "type": "timestamp with time zone",
            "nullable": false,
            "default": "now()",
            "description": "Record creation timestamp"
          }
        }
      },
      "financial_data": {
        "description": "Additional financial information",
        "columns": {
          "financial_id": {
            "type": "integer",
            "nullable": false,
            "primary_key": true,
            "description": "Unique financial record identifier"
          },
          "individual_id": {
            "type": "integer",
            "nullable": false,
            "foreign_key": {
              "references": "demographics.individual_id"
            },
            "description": "Reference to individual"
          },
          "household_income": {
            "type": "numeric",
            "nullable": true,
            "description": "Total household annual income",
            "constraints": {
              "min": 0
            }
          },
          "savings": {
            "type": "numeric",
            "nullable": true,
            "description": "Total savings amount",
            "constraints": {
              "min": 0
            }
          },
          "debt": {
            "type": "numeric",
            "nullable": true,
            "description": "Total debt amount",
            "constraints": {
              "min": 0
            }
          },
          "credit_score": {
            "type": "integer",
            "nullable": true,
            "description": "Credit score",
            "constraints": {
              "min": 300,
              "max": 850
            }
          },
          "home_ownership": {
            "type": "character varying",
            "nullable": true,
            "description": "Home ownership status",
            "allowed_values": ["Own", "Rent", "Living with family", "Other"]
          },
          "investment_portfolio": {
            "type": "numeric",
            "nullable": true,
            "description": "Total investment portfolio value",
            "constraints": {
              "min": 0
            }
          },
          "created_at": {
            "type": "timestamp with time zone",
            "nullable": false,
            "default": "now()",
            "description": "Record creation timestamp"
          },
          "updated_at": {
            "type": "timestamp with time zone",
            "nullable": false,
            "default": "now()",
            "description": "Record last update timestamp"
          }
        }
      }
    },
    "relationships": {
      "demographics_to_employment": {
        "type": "one_to_many",
        "from": "demographics.individual_id",
        "to": "employment.individual_id",
        "description": "One individual can have multiple employment records"
      },
      "demographics_to_health": {
        "type": "one_to_many",
        "from": "demographics.individual_id",
        "to": "health_metrics.individual_id",
        "description": "One individual can have multiple health measurements"
      },
      "demographics_to_education": {
        "type": "one_to_many",
        "from": "demographics.individual_id",
        "to": "education.individual_id",
        "description": "One individual can have multiple education records"
      },
      "demographics_to_survey": {
        "type": "one_to_many",
        "from": "demographics.individual_id",
        "to": "survey_responses.individual_id",
        "description": "One individual can have multiple survey responses"
      },
      "demographics_to_financial": {
        "type": "one_to_many",
        "from": "demographics.individual_id",
        "to": "financial_data.individual_id",
        "description": "One individual can have multiple financial records"
      }
    },
    "common_analysis_variables": {
      "demographic": ["age", "gender", "race", "ethnicity", "location", "country"],
      "socioeconomic": ["income", "salary", "employment_status", "education_level", "home_ownership"],
      "health": ["height", "weight", "bmi", "blood_pressure", "cholesterol", "glucose"],
      "behavioral": ["survey_responses", "response_category", "response_numeric"],
      "financial": ["household_income", "savings", "debt", "credit_score", "investment_portfolio"],
      "temporal": ["birth_date", "measurement_date", "response_date", "graduation_year"]
    },
    "sample_queries": {
      "age_income_correlation": "SELECT age, income FROM demographics d JOIN employment e ON d.individual_id = e.individual_id WHERE income IS NOT NULL AND age IS NOT NULL",
      "education_salary_analysis": "SELECT education_level, AVG(salary) as avg_salary FROM employment e JOIN demographics d ON e.individual_id = d.individual_id WHERE salary IS NOT NULL GROUP BY education_level",
      "health_demographics": "SELECT age, gender, bmi, blood_pressure_systolic FROM demographics d JOIN health_metrics h ON d.individual_id = h.individual_id WHERE bmi IS NOT NULL"
    }
  }
}